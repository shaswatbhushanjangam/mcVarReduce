\name{importance_sampling}
\alias{importance_sampling}
\title{Estimate the Target Integral with Importance Sampling}
\description{
Estimates \eqn{\int_0^1 e^x dx = e - 1} with the proposal density
\eqn{q(x)=2(1+x)/3} on \eqn{[0,1]}.
}
\usage{
importance_sampling(budget = 10000, seed = NULL)
}
\arguments{
\item{budget}{A positive whole number giving the number of weighted target-function evaluations. At least two are required.}
\item{seed}{\code{NULL} or a nonnegative whole number used for reproducibility.}
}
\details{
Proposal draws are generated by inverse transformation. If \eqn{U} is uniform
on \eqn{[0,1]}, then \eqn{X=sqrt(1+3U)-1} has density
\eqn{q(x)=2(1+x)/3}. Each contribution is weighted as \eqn{e^X/q(X)}.
}
\section{Assumptions}{
The generated proposal draws are independent. The proposal density is positive
where the integrand is nonzero, so all required importance weights are defined.
The selected proposal is fixed rather than estimated from the same simulation.
}
\value{
A named list containing \code{method}, \code{estimate}, \code{true_value},
\code{error}, \code{absolute_error}, \code{mcse},
\code{contribution_variance}, \code{budget}, and \code{proposal}.
}
\examples{
result <- importance_sampling(budget = 2000, seed = 8670)
result[c("estimate", "true_value", "mcse", "proposal")]
}
